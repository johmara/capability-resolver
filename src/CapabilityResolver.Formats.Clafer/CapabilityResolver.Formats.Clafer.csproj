<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CapabilityResolver.Formats.Clafer</PackageId>
    <Description>Clafer feature model reader (feature-model subset) for CapabilityResolver.</Description>
    <!-- ANTLR-generated code carries CLSCompliant attributes; the assembly does not declare CLS compliance. -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <ProjectReference Include="..\CapabilityResolver.Core\CapabilityResolver.Core.csproj" />
  </ItemGroup>

</Project>
